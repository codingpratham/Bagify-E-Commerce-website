generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id String @id @default(cuid())
  name String
  email String @unique
  password String
  role Role @default(USER)

  isOnBoarded Boolean @default(false)
  address String?
  phone String?
  city String?
  state String?
  country String?
  postalCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  carts Cart[]
  orders Order[]

}

model Product{
  id String @id @default(cuid())
  title String
  description String
  price Float
  image String
  category String
  status Status @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  userId String
  stock Int
  orders Order[]
  carts Cart[]
}

model Cart{
  id String @id @default(cuid())
  user User @relation(fields: [userId], references: [id])
  userId String
  product Product @relation(fields: [productId], references: [id])
  productId String
  quantity Int
}

model Order {
  id           String   @id @default(uuid())

  user         User     @relation(fields: [userId], references: [id])
  userId       String
  
  totalAmount  Float
  razorpayOrderId String @unique
  razorpayPaymentId String?
  razorpaySignature String?
  currency     String   @default("INR")
  receipt      String

  product Product @relation(fields: [productId], references: [id])
  productId String
  
  status       Status   @default(PENDING)
  createdAt    DateTime @default(now())
}


enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED

}